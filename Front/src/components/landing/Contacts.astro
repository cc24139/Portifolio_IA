---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";
import { activeProfile } from "@/data/Profiles/activeProfile";

const platformSlugs: Record<string, string> = {
  LinkedIn: "linkedin",
  Kaggle: "kaggle",
  "Hugging Face": "huggingface",
  GitHub: "github",
};
---

<section class="scroll-mt-32" id="contato">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 items-start lg:grid-cols-4">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300">
          Encontre-me também em
        </Text>
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug tracking-tighter text-base-900 dark:text-white lg:col-span-2"
      >
        Contato
      </Text>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-8 sm:grid-cols-4">
      {
        activeProfile.footerLinks.map((link) => {
          const slug = platformSlugs[link.text];

          return (
            <article class="flex flex-col items-center gap-5 border-t border-base-200 py-8 text-center dark:border-base-800">
              <img
                src={`https://cdn.simpleicons.org/${slug}`}
                alt={`Logo ${link.text}`}
                width="56"
                height="56"
                loading="lazy"
                class="size-14 object-contain dark:invert"
              />
              <Text
                tag="h3"
                variant="textSM"
                class="font-medium text-base-900 dark:text-white"
              >
                {link.text}
              </Text>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs tracking-tight text-accent-700 transition-colors hover:text-accent-900 dark:text-accent-400 dark:hover:text-accent-300"
              >
                Clique aqui
              </a>
            </article>
          );
        })
      }
    </div>
  </Wrapper>
</section>
