---
import type { CasePipelineStep } from "@/data/Profiles/GENIA/portfolio";

interface Props {
  steps: CasePipelineStep[];
}

const { steps } = Astro.props;
---

<section class="case-pipeline mt-16 border-y border-base-200 py-12 dark:border-base-800 lg:mt-24 lg:py-16" aria-labelledby="pipeline-title">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-4 lg:gap-12">
    <div>
      <p class="text-xs uppercase text-base-600 dark:text-base-300">Fluxo de IA</p>
    </div>
    <div class="lg:col-span-3">
      <h2 id="pipeline-title" class="text-2xl font-semibold leading-tight tracking-tighter text-base-900 dark:text-white">
        Da coleta à triagem
      </h2>
      <p class="mt-3 max-w-2xl text-sm text-base-600 dark:text-base-300">
        O serviço de IA analisa imagem e medições em caminhos próprios; a API reúne os resultados para registrar a coleta.
      </p>

      <ol class="mt-10 grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2 xl:grid-cols-4 xl:gap-x-8">
        {steps.map((step, index) => (
          <li class="pipeline-step relative border-t border-base-200 pt-5 dark:border-base-800">
            <div class="absolute left-0 top-0 h-0.5 w-10 bg-accent-500" aria-hidden="true"></div>
            <div class="flex min-h-8 items-center justify-between gap-3">
              <p class="text-[11px] font-medium uppercase tracking-wide text-accent-700 dark:text-accent-400">
                {step.eyebrow}
              </p>
            </div>
            {index < steps.length - 1 && (
              <span class="pipeline-arrow hidden xl:inline" aria-hidden="true">→</span>
            )}
            <h3 class="mt-4 text-lg font-semibold leading-tight text-base-900 dark:text-white">
              {step.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-base-600 dark:text-base-300">
              {step.text}
            </p>

            {step.details && (
              <ul class="mt-4 space-y-2 border-l border-accent-500/50 pl-3 text-xs leading-relaxed text-base-600 dark:text-base-300">
                {step.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}

            {step.branches && (
              <div class="mt-4 space-y-3">
                {step.branches.map((branch) => (
                  <div class="border-l-2 border-accent-500/70 pl-3">
                    <h4 class="text-xs font-semibold leading-snug text-base-900 dark:text-white">
                      {branch.title}
                    </h4>
                    <p class="mt-1.5 text-xs leading-relaxed text-base-600 dark:text-base-300">
                      {branch.text}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1280px) {
    .pipeline-arrow {
      position: absolute;
      top: 1.35rem;
      right: -0.9rem;
      font-size: 1.1rem;
      color: var(--color-accent-600);
    }
  }
</style>
