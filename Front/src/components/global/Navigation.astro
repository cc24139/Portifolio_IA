---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { activeProfile } from "@/data/Profiles/activeProfile";

const navigationLinks = [
  ...activeProfile.navigationLinks,
  { href: activeProfile.contactHref, text: activeProfile.contactLabel },
];
---

<nav class="bg-white dark:bg-base-950 fixed top-0 z-10 w-full">
  <Wrapper variant="standard" class="py-2">
    <div class="grid grid-cols-2 lg:grid-cols-3 items-start">
      <Text
        tag="p"
        variant="textXS"
        class="text-base-600 dark:text-base-300 tracking-tight font-base"
      >
        {activeProfile.location}<br />
        {activeProfile.role}
      </Text>
      <div class="hidden lg:col-span-2 lg:flex lg:justify-center gap-8 text-sm items-center">
        {
          navigationLinks.map((link) => (
            <a
              href={link.href}
              data-cursor-magnetic
              class="px-2 py-3 text-base-600 dark:text-base-300 tracking-tight text-sm transition-colors hover:text-accent-700 dark:hover:text-accent-400"
            >
              {link.text}
            </a>
          ))
        }
      </div>
      <a
        href={activeProfile.contactHref}
        data-cursor-magnetic
        class="px-2 py-3 text-base-600 dark:text-base-300 text-sm tracking-tight font-base ml-auto transition-colors hover:text-accent-700 dark:hover:text-accent-400 lg:hidden"
      >
        {activeProfile.contactLabel}
      </a>
    </div>
  </Wrapper>
</nav>

