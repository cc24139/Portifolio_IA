---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { GENIA } from "@/data/Profiles/GENIA/GENIA";
---
<section>
  <Wrapper variant="standard" class="pb-8 pt-40 lg:pt-80">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-4 lg:gap-12">
      <div class="profile-photo mx-auto lg:col-span-1 lg:col-start-1 lg:mx-0">
        <img
          src="/Profile/FotoProvisoria.png"
          alt="Imagem provisória de perfil"
          width="220"
          height="220"
        />
      </div>
      <Text
        tag="h1"
        variant="displayLG"
        class="font-semibold leading-snug text-left tracking-tighter text-base-900 dark:text-white lg:col-span-3 lg:col-start-2"
      >
        {GENIA.intro}
      </Text>
    </div>
  </Wrapper>
</section>




<style>
  .profile-photo {
    width: min(220px, 70vw);
    aspect-ratio: 1;
    padding: 4px;
    border-radius: 50%;
    background: conic-gradient(from 35deg, #63e6be, #5c7cfa, #da77f2, #63e6be);
    box-shadow: 0 0 16px rgb(99 230 190 / 45%), 0 0 32px rgb(92 124 250 / 25%);
    transition: box-shadow 250ms ease, transform 250ms ease;
  }

  .profile-photo:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgb(99 230 190 / 60%), 0 0 40px rgb(92 124 250 / 35%);
  }

  .profile-photo img {
    display: block;
    width: 100%;
    height: 100%;
    border: 3px solid var(--color-base-950);
    border-radius: 50%;
    object-fit: cover;
  }
</style>
